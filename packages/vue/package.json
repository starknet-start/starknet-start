{
  "name": "starknet-vue",
  "version": "0.0.1-alpha.2",
  "private": true,
  "homepage": "https://start.starknet-react.com/",
  "license": "MIT",
  "repository": "starknet-start/starknet-start",
  "type": "module",
  "main": "./src/index.ts",
  "exports": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "files": [
      "dist",
      "src",
      "README.md"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@starknet-io/get-starknet-core": "^5.0.0",
    "@starknet-io/get-starknet-wallet-standard": "^5.0.0",
    "@starknet-io/types-js": "^0.10.1",
    "@starknet-start/chains": "workspace:^",
    "@starknet-start/explorers": "workspace:^",
    "@starknet-start/providers": "workspace:^",
    "@starknet-start/query": "workspace:^",
    "@tanstack/vue-query": "^5.25.0",
    "abi-wan-kanabi": "^2.2.4",
    "eventemitter3": "^5.0.1",
    "viem": "^2.21.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@starknet-start/explorers": "workspace:^",
    "@starknet-start/providers": "workspace:^",
    "@starknet-start/query": "workspace:^",
    "@starknet-start/typescript-config": "workspace:^",
    "@vue/test-utils": "^2.4.6",
    "rimraf": "^4.1.2",
    "starknet": "10.0.2",
    "tsup": "^8.0.2",
    "vitest": "^4.0.15",
    "vue": "^3.4.0"
  },
  "peerDependencies": {
    "starknet": "10.0.2",
    "vue": "^3.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
